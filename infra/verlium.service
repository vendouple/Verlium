# /etc/systemd/system/verlium.service on the OCI Ampere A1 VM (Ubuntu/Oracle Linux)
[Unit]
Description=Verlium API server
After=network-online.target
Wants=network-online.target

[Service]
User=verlium
WorkingDirectory=/opt/verlium/server
EnvironmentFile=/opt/verlium/server/.env
ExecStart=/opt/verlium/server/.venv/bin/uvicorn verlium.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
