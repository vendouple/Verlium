# Copy to server/.env and fill in. Never commit .env.

# Oracle Autonomous AI Database (TLS, no wallet): paste the "TLS" connection string
# from OCI console > Autonomous Database > Database connection, e.g.
# (description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.eu-frankfurt-1.oraclecloud.com))(connect_data=(service_name=xxx_verlium_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
VERLIUM_DB_DSN=
VERLIUM_DB_USER=VERLIUM
VERLIUM_DB_PASSWORD=

# Only needed once, for `python -m verlium.migrate --bootstrap-user`
VERLIUM_DB_ADMIN_PASSWORD=

# Optional mTLS wallet instead of TLS: path to the unzipped wallet folder
VERLIUM_DB_WALLET_DIR=
VERLIUM_DB_WALLET_PASSWORD=

# Single-user bearer token the apps send. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
VERLIUM_API_TOKEN=

# Encrypts provider API keys at rest. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
VERLIUM_SECRET_KEY=

# Where uploaded source files and generated media are stored
VERLIUM_DATA_DIR=./data
